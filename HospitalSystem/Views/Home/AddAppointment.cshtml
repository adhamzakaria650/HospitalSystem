@model IEnumerable<Doctor>
<style>
    doctor-img {
        height: 250px;
        object-fit: cover; /* لضمان عدم تمدد الصورة بشكل مشوه */
    }

    /* خلفية الكارت باللون الأبيض مثل الصورة */
    .card {
        background-color: #ffffff;
        border-radius: 6px;
        overflow: hidden;
    }
</style>

<div class="container my-5">

    <!-- Title -->
    <h1 class="text-center mb-4 fw-bold">Our Doctors</h1>

    <!-- Search and Filter Form -->
    <form method="get" class="row g-2 mb-4">
        <div class="col-md-4">
            <input type="text" name="Name" class="form-control" placeholder="Search by name">
        </div>
        <div class="col-md-4">
            <select name="Specialization" class="form-select">
                <option value="0">All Specializations</option>

                @foreach(var i in ViewBag.specializations)
                {
                    <option value="@i.Id">@i.Name</option>
                }
            </select>
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-primary w-100">Filter</button>
        </div>
        <div class="col-md-2">
            <a href="@Url.Action("Index")" class="btn btn-secondary w-100">Reset</a>
        </div>
    </form>

    <!-- Doctors Cards Grid -->
    <div class="row row-cols-1 row-cols-md-3 g-4">
        @foreach(var i in Model)
        {
            <div class="col">
                <div class="card h-100 border-0 shadow-sm text-center">
                    <img src="~/images/@i.Photo" class="card-img-top doctor-img" alt="Doctor">
                    <div class="card-body d-flex flex-column align-items-center">
                        <h5 class="card-title fw-bold text-dark mb-1">Dr @i.Name</h5>
                        <p class="card-text text-muted mb-3">@i.specialization.Name</p>
                        <a href="/Home/MakeAppointment?doctorId=@i.Id" class="btn btn-primary mt-auto px-4">Make Appointment</a>
                    </div>
                </div>
            </div>
        }
    </div>
    <nav aria-label="Page navigation example" class="d-flex justify-content-center align-items-center mt-4">
        <ul class="pagination mb-0">
            <li class="page-item @((ViewBag.page == 1) ? "disabled" : "")">
                <a class="page-link" href="/Home/AddAppointment?page=@(ViewBag.page-1)" aria-label="Previous">
                    <span aria-hidden="true">&laquo;</span>
                </a>
            </li>
            @for (int i = 1; i <= ViewBag.pages; i++)
            {
                <li class="page-item">
                    <a class="page-link" href="/Home/AddAppointment?page=@i">@i</a>
                </li>
            }
            <li class="page-item @(ViewBag.page == ViewBag.pages ? "disabled" : "")">
                <a class="page-link" href="/Home/AddAppointment?page=@(ViewBag.page + 1)" aria-label="Next">
                    <span aria-hidden="true">&raquo;</span>
                </a>
            </li>
        </ul>
    </nav>
</div>